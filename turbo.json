{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  // Agent instructions live in CLAUDE.md, which already points at turbo's
  // bundled docs; stop turbo from writing its own AGENTS.md.
  "agentGuidance": false,
  "globalDependencies": [".nvmrc", "pnpm-workspace.yaml"],
  "tasks": {
    // Internal packages ship TypeScript source with no build (ADR-0007), so no
    // task waits on a dependency's output. Depending on this no-op task instead
    // folds each dependency's source hash into the consumer's cache key: editing
    // @ygo/contracts re-runs every consumer's typecheck rather than replaying a
    // stale pass.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^transit"],
      "outputs": [],
      // apps/server's tests create their own database on this server. Where it
      // runs changes no result, so it reaches the task without joining the hash.
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^transit"],
      // Vite and Expo read an app's git-ignored .env at build time, so a
      // changed value must miss the cache rather than replay an old bundle.
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    }
  }
}
