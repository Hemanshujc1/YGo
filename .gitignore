# Reference material: keep locally, never track in YGo.
# Blanket rule — References/ holds third-party repositories, confidential documents
# and .env files. Nothing in it belongs in a public repository.
/References/

# Kept for clarity; the blanket rule above already covers these.
/References/Usthaan/usthaan-lekha/
/References/Usthaan/usthaan-media-ingestion-service/
/References/Usthaan/usthaan-sthaan/
/References/Usthaan/usthaan-ts-types/
/References/VaayuGO/

# Secrets: the repository is public (PRD Q-9). Configuration is environment
# variables only (ADR-0008); CI also runs a secret scan on every pull request.
.env*
!.env.example

# Dependencies and build output.
node_modules/
.turbo/
dist/
build/
coverage/
*.tsbuildinfo
.DS_Store

# Claude Design exports: large and kept locally by the owner, never tracked.
/docs/design/*.html
/docs/design/*.pdf
/docs/design/*.code-workspace
