# EXPO_PUBLIC_ values are public and included in the app bundle. Never put secrets here.

EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# Google OAuth IDs: Web client for server verification, iOS client for this app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# The Google map keys (#307): the same two keys as the Customer app, with this
# app added to each key's restrictions (apps/customer/README.md, The map keys).
# Without them the map on S17 is blank.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# This app's own Expo project, which its push tokens belong to (#507). While
# unset, the phone registers for no push; S41 and the Home bell still work.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Android's push needs the Firebase project's google-services.json (README,
# Push): the path to it, e.g. ./google-services.json (git-ignored). An EAS
# cloud build sets it as a file variable instead.
GOOGLE_SERVICES_JSON=
