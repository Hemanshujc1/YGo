# EXPO_PUBLIC_ values are public and included in the app bundle. Never put secrets here.

EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# Google OAuth IDs: Web client for server verification, iOS client for this app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# The Google map keys (#307): the same two keys as the Customer app, with this
# app added to each key's restrictions (apps/customer/README.md, The map keys).
# Without them the map on S17 is blank.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
