# Copy to .env (git-ignored). EXPO_PUBLIC_ values are written into the app
# bundle at build time, so they are public: never put a secret here.

# The iOS simulator reaches the Mac at 127.0.0.1, the Android emulator at
# 10.0.2.2, and a real phone at the Mac's LAN address (server started with
# HOST=0.0.0.0).
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
# Where Help and a phone already in use point.
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional until the store listings exist; while unset, the update screen
# names the stores instead of showing a button. A store build needs both.
EXPO_PUBLIC_ANDROID_STORE_URL=
EXPO_PUBLIC_IOS_STORE_URL=
# The Maps SDK for Android key (#255). The build writes it into the Android
# app (its manifest and its Expo config), as Android map keys always are, so
# restrict it to this app's package and SHA-1. Without it the map is blank.
GOOGLE_MAPS_ANDROID_API_KEY=
