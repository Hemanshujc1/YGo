# Copy to .env for local development. Production sets these from SSM Parameter
# Store before the process starts (ADR-0008); the application never reads SSM.
DATABASE_URL=postgres://ygo:ygo@localhost:5432/ygo
MAILER=mailpit
MAIL_FROM=ygo@example.invalid
MAILPIT_URL=http://localhost:8025
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
MIN_CUSTOMER_VERSION=0.0.0
MIN_SHOPKEEPER_VERSION=0.0.0
