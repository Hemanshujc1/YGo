# Copy to .env for local development. Production sets these from SSM Parameter
# Store before the process starts (ADR-0008); the application never reads SSM.
DATABASE_URL=postgres://ygo:ygo@localhost:5432/ygo
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
MAILER=mailpit
MAIL_FROM=ygo@example.invalid
MAILPIT_URL=http://localhost:8025
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
MIN_CUSTOMER_VERSION=0.0.0
MIN_SHOPKEEPER_VERSION=0.0.0
# C15's place search (#257): a Google key limited to Places API (New). Without
# it the search answers UNAVAILABLE. Secret: never in the apps or in Git.
# GOOGLE_PLACES_API_KEY=
# AWS product image storage:
# PRODUCT_IMAGE_BUCKET=ygo-product-images
# PRODUCT_IMAGE_CLOUDFRONT_DOMAIN=images.example.com
# S3_REGION=ap-south-1
# Local SeaweedFS storage (see apps/server/README.md):
# PRODUCT_IMAGE_BUCKET=ygo-product-images
# PRODUCT_IMAGE_LOCAL_BASE_URL=http://127.0.0.1:8333/ygo-product-images
# S3_ENDPOINT=http://127.0.0.1:8333
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local-secret

# Comma-separated allowed OAuth audiences. Empty disables that provider.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
