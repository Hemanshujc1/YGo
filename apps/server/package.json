{
  "name": "@ygo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "node scripts/build.js",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/client-sesv2": "3.1150.0",
    "@fastify/multipart": "10.1.4",
    "@smithy/node-http-handler": "4.12.1",
    "@ygo/contracts": "workspace:*",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "fflate": "0.8.3",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@ygo/eslint-config": "workspace:*",
    "@ygo/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
